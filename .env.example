# Primary database — all writes
DATABASE_URL=postgres://USER:PASSWORD@localhost:5433/DBNAME

# Read replica — optional. If unset, reads fall back to the primary.
DATABASE_URL_REPLICA=postgres://USER:PASSWORD@localhost:5434/DBNAME

KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=ticketflow
PORT=3000
NODE_ENV=development

# --- Redis (optional: cache + virtual queue). Remove to use in-process fallback.
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3

# --- Two-phase booking
HOLD_MINUTES=5
EXPIRY_SWEEP_MS=30000

# --- Virtual waiting room (off by default so load tests are unaffected)
QUEUE_ENABLED=false
QUEUE_CAPACITY=50

# --- Deployment ---
# PGSSL=true            required by managed Postgres (Render, Neon, Supabase)
# KAFKA_ENABLED=false   skip async events where no broker exists
# PG_POOL_MAX=8         smaller pool for small instances
